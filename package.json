{
  "name": "eternum",
  "version": "2.2.0",
  "description": "SGRSI — Sistema de Gestión de Recursos del ITI CETP",
  "private": true,
  "scripts": {
    "main": "node scripts/main.js",
    "main:xampp": "node scripts/main.js --modo=xampp",
    "main:mariadb": "node scripts/main.js --modo=mariadb",
    "doctor": "node scripts/doctor.js",
    "css": "tailwindcss -i assets/css/input.css -o assets/css/app.css --minify",
    "css:watch": "tailwindcss -i assets/css/input.css -o assets/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
